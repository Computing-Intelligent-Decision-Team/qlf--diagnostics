+bool LayoutWriter::loadGdsExportMapFromEnv() {
+  _bUseGdsExportMap = false;
+  _gdsExportMapPath = "";
+  _gdsExportMap.clear();
+  _gdsExportMappedCounts.clear();
+  _gdsExportUnmappedShapeCounts.clear();
+  _gdsExportTextCounts.clear();
 
-PROJECT_NAMESPACE_END
+  const char* envValue = std::getenv("MAGICAL_GDS_EXPORT_MAP");
+  if (envValue == nullptr || String_t(envValue).empty()) {
+    return true;
