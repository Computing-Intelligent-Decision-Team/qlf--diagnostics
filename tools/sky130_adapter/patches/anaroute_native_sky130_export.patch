+
+  _gdsExportMapPath = envValue;
+  return loadGdsExportMap(_gdsExportMapPath);
+}
+
+bool LayoutWriter::loadGdsExportMap(const String_t& filename) {
+  std::ifstream fp(filename);
+  if (!fp.good()) {
+    fprintf(stderr, "LayoutWriter::%s ERROR: Cannot open GDS export map %s.\n", __func__, filename.c_str());
+    return false;
+  }
+
+  String_t line;
+  UInt_t lineNum = 0;
+  while (std::getline(fp, line)) {
+    ++lineNum;
+    stripComment(line);
+    line = trimCopy(line);
+    if (line.empty()) {
+      continue;
+    }
+
+    std::istringstream iss(line);
+    Int_t inputLayer = 0;
+    Int_t inputDatatype = 0;
+    Int_t outputLayer = 0;
+    Int_t outputDatatype = 0;
+    if (!(iss >> inputLayer >> inputDatatype >> outputLayer >> outputDatatype)) {
+      fprintf(stderr, "LayoutWriter::%s ERROR: Invalid export map row %u in %s: %s\n",
+              __func__, lineNum, filename.c_str(), line.c_str());
+      return false;
+    }
+    String_t name;
+    std::getline(iss, name);
+    name = trimCopy(name);
+    if (name.empty()) {
+      name = "unnamed";
+    }
+
+    const LayerDataTypeKey key(inputLayer, inputDatatype);
+    GdsExportMapValue value;
+    value.layer = outputLayer;
+    value.datatype = outputDatatype;
+    value.name = name;
+    _gdsExportMap[key] = value;
+  }
+
+  if (_gdsExportMap.empty()) {
+    fprintf(stderr, "LayoutWriter::%s ERROR: GDS export map %s contains no mapping rows.\n",
+            __func__, filename.c_str());
+    return false;
+  }
+
+  _bUseGdsExportMap = true;
+  fprintf(stderr, "LayoutWriter::%s INFO: Loaded %zu GDS export map rows from %s.\n",
+          __func__, _gdsExportMap.size(), filename.c_str());
+  return true;
+}
+
+bool LayoutWriter::remapLayerDatatype(Int_t& layer, Int_t& datatype) {
+  if (!_bUseGdsExportMap) {
+    return false;
+  }
+  const LayerDataTypeKey original(layer, datatype);
+  const auto iter = _gdsExportMap.find(original);
+  if (iter == _gdsExportMap.end()) {
+    _gdsExportUnmappedShapeCounts[original] += 1;
+    return false;
+  }
+
+  layer = iter->second.layer;
+  datatype = iter->second.datatype;
+  _gdsExportMappedCounts[original] += 1;
+  return true;
+}
+
+struct RemapGdsExportShapeAction {
+  LayoutWriter& writer;
+
+  explicit RemapGdsExportShapeAction(LayoutWriter& w) : writer(w) {}
+
+  template<typename ObjectType>
+  void operator()(::GdsParser::GdsRecords::EnumType type, ObjectType* object) {
+    remap(type, object);
+  }
+
+  String_t message() const {
+    return "RemapGdsExportShapeAction";
+  }
+
+  template<typename ObjectType>
+  void remap(::GdsParser::GdsRecords::EnumType, ObjectType*) {}
+
+  void remap(::GdsParser::GdsRecords::EnumType, ::GdsParser::GdsDB::GdsPolygon* object) {
+    Int_t layer = object->layer();
+    Int_t datatype = object->datatype();
+    writer.remapLayerDatatype(layer, datatype);
+    object->setLayer(layer);
+    object->setDatatype(datatype);
+  }
+
+  void remap(::GdsParser::GdsRecords::EnumType, ::GdsParser::GdsDB::GdsRectangle* object) {
+    Int_t layer = object->layer();
+    Int_t datatype = object->datatype();
+    writer.remapLayerDatatype(layer, datatype);
+    object->setLayer(layer);
+    object->setDatatype(datatype);
+  }
+
+  void remap(::GdsParser::GdsRecords::EnumType, ::GdsParser::GdsDB::GdsPath* object) {
+    Int_t layer = object->layer();
+    Int_t datatype = object->datatype();
+    writer.remapLayerDatatype(layer, datatype);
+    object->setLayer(layer);
+    object->setDatatype(datatype);
+  }
+
+  void remap(::GdsParser::GdsRecords::EnumType, ::GdsParser::GdsDB::GdsText* object) {
+    writer._gdsExportTextCounts[LayoutWriter::LayerDataTypeKey(object->layer(), object->texttype())] += 1;
+  }
+};
+
+void LayoutWriter::remapGdsDB(GdsDB& gdsDB) {
+  if (!_bUseGdsExportMap) {
+    return;
+  }
+
+  for (auto& cell : gdsDB.cells()) {
+    for (auto& obj : cell.objects()) {
+      GdsParser::GdsDB::GdsObjectHelpers()(obj.first, obj.second, RemapGdsExportShapeAction(*this));
+    }
+  }
+}
+
+void LayoutWriter::writeGdsExportMapReport(const String_t& outputFilename) const {
+  if (!_bUseGdsExportMap) {
+    return;
+  }
+
+  const String_t reportFilename = outputFilename + ".export_map_report.md";
+  std::ofstream fp(reportFilename);
+  if (!fp.good()) {
+    fprintf(stderr, "LayoutWriter::%s WARNING: Cannot write GDS export map report %s.\n",
+            __func__, reportFilename.c_str());
+    return;
+  }
+
+  fp << "# MAGICAL GDS Export Map Report\n\n";
+  fp << "- Output GDS: `" << outputFilename << "`\n";
+  fp << "- Export map: `" << _gdsExportMapPath << "`\n";
+  fp << "- Map rows: " << _gdsExportMap.size() << "\n";
+  fp << "- Text records: left unchanged in Native Sky130 Export Phase 1.\n\n";
 
+  fp << "## Mapped Shape Layers\n\n";
+  fp << "| Input layer | Input datatype | Output layer | Output datatype | Name | Count |\n";
+  fp << "| ---: | ---: | ---: | ---: | --- | ---: |\n";
+  for (const auto& pair : _gdsExportMappedCounts) {
+    const auto iter = _gdsExportMap.find(pair.first);
+    if (iter == _gdsExportMap.end()) {
+      continue;
+    }
+    fp << "| " << pair.first.first << " | " << pair.first.second
+       << " | " << iter->second.layer << " | " << iter->second.datatype
+       << " | " << iter->second.name << " | " << pair.second << " |\n";
+  }
+
+  fp << "\n## Preserved Unmapped Shape Layers\n\n";
+  fp << "| Layer | Datatype | Count | Reason |\n";
+  fp << "| ---: | ---: | ---: | --- |\n";
+  for (const auto& pair : _gdsExportUnmappedShapeCounts) {
+    fp << "| " << pair.first.first << " | " << pair.first.second
+       << " | " << pair.second << " | not listed in MAGICAL_GDS_EXPORT_MAP |\n";
+  }
+
+  fp << "\n## Preserved Text Layers\n\n";
+  fp << "| Text layer | Texttype | Count | Reason |\n";
+  fp << "| ---: | ---: | ---: | --- |\n";
+  for (const auto& pair : _gdsExportTextCounts) {
+    fp << "| " << pair.first.first << " | " << pair.first.second
+       << " | " << pair.second << " | native pin label/shape export deferred |\n";
+  }
+}
+
+
+PROJECT_NAMESPACE_END
